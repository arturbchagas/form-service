generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  novo
  aprovado
  reprovado
  pago
  pronto
  entregue
  cancelado
}

model ServiceOrder {
  id String @id @default(cuid()) @unique
  name String 
  phone String?
  email String?
  address String?
  brand String?
  model String?
  serialNumber String? @unique
  defects String
  defectsHistory String?
  status OrderStatus @default(novo)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}
