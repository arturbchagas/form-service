generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  novo
  aprovado
  reprovado
  pago
  pronto
  entregue
  cancelado
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  serviceOrders ServiceOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceOrder {
  id String @id @default(cuid()) @unique
  name String 
  phone String?
  email String?
  address String?
  brand String?
  model String?
  serialNumber String? @unique
  defects String
  defectsHistory String?
  status OrderStatus @default(novo)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @updatedAt
}