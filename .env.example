# PostgreSQL (Neon ou outro provedor)
# Copie a connection string do painel do Neon → Connection Details → Prisma
DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"

# Opcional: URL pooled do Neon (recomendado na Vercel). Se não definir, usa DATABASE_URL.
# POSTGRES_PRISMA_URL="postgresql://usuario:senha@host/neondb?sslmode=require&pgbouncer=true"

# NextAuth — gere com: openssl rand -base64 32
NEXTAUTH_SECRET="cole-um-segredo-aleatorio-aqui"

# URL pública do app (local ou produção)
NEXTAUTH_URL="http://localhost:3000"
